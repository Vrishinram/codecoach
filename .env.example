# =====================================================================
# CodeCoach - Real-Time C#/.NET Educator Chatbot Environment Variables
# =====================================================================

# --- Assistant Identity ---
ASSISTANT_NAME=CodeCoach
APP_URL=http://localhost:8000
ENVIRONMENT=development
# Optional HTTP Basic Auth for public deployment (leave blank for open local dev)
AUTH_USERNAME=
AUTH_PASSWORD=

# --- LLM Configuration (Groq Cloud, xAI Grok, Google Gemini, OpenRouter) ---
# Groq Cloud API Key (starts with gsk_ from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# xAI Grok API Key (starts with xai- from https://console.x.ai)
XAI_API_KEY=xai_your_xai_api_key_here
GROK_MODEL=grok-2-latest

# Primary Google Gemini API key (free tier available at https://aistudio.google.com/)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# OpenRouter LLM Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=anthropic/claude-3.5-sonnet
FALLBACK_MODELS=google/gemini-2.0-flash-001,openai/gpt-4o-mini,meta-llama/llama-3.3-70b-instruct
TEMPERATURE=0.3
MAX_TOKENS=8192

# --- Training & Learning Verification Parameters ---
SET_SIZE=25
PASS_SCORE=70
MASTERY_SCORE=85
RATE_LIMIT_PER_MINUTE=30

# --- Email (SMTP - Gmail App Password supported) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_digit_gmail_app_password
EMAIL_FROM=CodeCoach <your_email@gmail.com>
USER_EMAIL=vrishinram4646@gmail.com

# --- Google OAuth 2.0 & Gmail API (One-click Sign in with Google, replaces SMTP) ---
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized Redirect URI: https://codecoach-blush.vercel.app/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# --- Web Push (VAPID) & Phone Notifications ---
# Generate using: python scripts/generate_vapid_keys.py
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:your_email@example.com
# Optional ntfy.sh topic fallback (instant push to Android/iOS without PWA setup)
NTFY_TOPIC=codecoach_my_private_topic_12345

# --- Scheduling & Timezone ---
# Comma-separated 24-hour reminder times
REMINDER_TIMES=08:00,20:00
TIMEZONE=Asia/Kolkata

